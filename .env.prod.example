# Production env for docker-compose.prod.yml. Copy to .env.prod and fill in.
# (./docker/prod-up.sh copies this for you on first run.)

DEBUG=False
# Generate one line: openssl rand -base64 48 | tr -d '\n'; echo
SECRET_KEY=
ALLOWED_HOSTS=ssh.yourco.com

# Caddy site address (the hostname Caddy answers on).
SYNCSSH_SITE_ADDRESS=ssh.yourco.com
ACME_EMAIL=you@yourco.com

# How Caddy gets its TLS cert:
#   (empty)      → automatic Let's Encrypt. Use when NOTHING proxies in front.
#   tls internal → Caddy self-signed. Use behind Cloudflare in "Full" mode
#                  (no Let's Encrypt), or for a local trial.
#   tls /etc/caddy/origin/cert.pem /etc/caddy/origin/key.pem
#                → serve a Cloudflare Origin CA cert (pair with CF "Full (strict)").
#                  Put the two files in docker/cf-origin/ (gitignored).
#
# --- Behind Cloudflare (proxied / orange cloud) ---
# Do NOT use Let's Encrypt here (the ACME challenge can't reach the origin).
# Do NOT use CF "Flexible" mode (unencrypted origin hop + redirect loop).
# Easiest:  CF SSL = Full         + CADDY_TLS=tls internal
# Best:     CF SSL = Full (strict)+ CADDY_TLS=tls /etc/caddy/origin/cert.pem /etc/caddy/origin/key.pem
# Also: lock the VPS firewall so :443 only accepts Cloudflare IP ranges, and
# set TRUSTED_PROXY=cloudflare below so real client IPs survive (rate limiting).
CADDY_TLS=

# Single origin — all the public HTTPS URL (for a local trial use https://localhost).
APP_BASE_URL=https://ssh.yourco.com
SYNC_BASE_URL=https://ssh.yourco.com
FRONTEND_BASE_URL=https://ssh.yourco.com
CORS_ORIGINS=https://ssh.yourco.com

# Branding shown in verification email subjects/bodies ("Hello from <name>!").
# SITE_DOMAIN defaults to the FRONTEND_BASE_URL host; override only if needed.
SITE_NAME=SyncSSH
# SITE_DOMAIN=ssh.yourco.com
ACCOUNT_DEFAULT_HTTP_PROTOCOL=https

# Real client IP for rate limiting / audit (the stack always has Caddy in front,
# so REMOTE_ADDR would otherwise be the proxy and collapse all visitors into one
# rate-limit bucket).
#   xff        → trust the reverse proxy's X-Forwarded-For (this Caddy stack, no CDN)
#   cloudflare → trust CF-Connecting-IP (set when behind Cloudflare; also firewall
#                the origin so :443 only accepts Cloudflare IP ranges)
TRUSTED_PROXY=xff
# Docker Compose assigns Caddy a private address. Narrow this further if your
# deployment uses a fixed Docker subnet.
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Required when TRUSTED_PROXY=cloudflare. Populate with Cloudflare's current
# published IPv4 and IPv6 proxy ranges, comma-separated. Without this setting,
# CF-Connecting-IP is ignored (safe failure: clients share the proxy IP).
# https://www.cloudflare.com/ips/
CLOUDFLARE_PROXY_CIDRS=

# Database (the "db" service; DB_HOST is forced to "db" by compose)
DB_NAME=syncssh
DB_USER=syncssh
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_PORT=5432

# Static files inside the container
STATIC_ROOT=/app/staticfiles

# Gunicorn workers — keep at 1 unless you enable Redis (see docker-compose.prod.yml)
GUNICORN_WORKERS=1
# REDIS_URL=redis://redis:6379/0

# Email — REQUIRED for signup verification. Without real delivery, new users
# can't confirm their address. Two ways to send via Lettermint:
#
# A) HTTP API (recommended — no outbound SMTP, which some hosts block):
EMAIL_BACKEND=syncssh.email_backends.LettermintAPIBackend
LETTERMINT_TOKEN=your-lettermint-project-token
DEFAULT_FROM_EMAIL=no-reply@syncssh.dev
#
# B) SMTP (alternative — needs outbound :587 open on the host):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.lettermint.co
# EMAIL_PORT=587
# EMAIL_HOST_USER=lettermint
# EMAIL_HOST_PASSWORD=your-lettermint-project-token
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@yourco.com
