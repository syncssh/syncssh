# Django
SECRET_KEY=change-me-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# Database
DB_NAME=syncssh
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# App URL — the backend URL embedded in browser-facing redirects (invite
# accept, email confirmation). Resolved by a human's browser, so it must be
# browser-resolvable. The install script's sync URL uses SYNC_BASE_URL below
# (which falls back to this), so on a single host you only set this one.
#
# Default has to be browser-resolvable, since a browser interpreting
# "backend" as a hostname will try DNS and can end up on backend.com
# (depending on your search domains).
#
#  - docker-compose local dev:    http://localhost:8000
#  - external VPS via tunnel:     https://<your-tunnel>.trycloudflare.com
#  - production:                  https://ssh.yourco.com
#
# See INSTALL.md for the full matrix.
APP_BASE_URL=http://localhost:8000

# Sync URL — base URL baked into the install script for the agent's ongoing
# /servers/sync cron. Resolved by the *target server*, not a browser.
# Leave unset to inherit APP_BASE_URL (correct for single-host + tunnel +
# production). Only set this when the target server reaches the backend over
# docker DNS — e.g. the bundled testvps container, which must use:
#   SYNC_BASE_URL=http://backend:8000
# This replaces the old "swap localhost → backend in the curl by hand" step.
# SYNC_BASE_URL=http://backend:8000

# Frontend URL — where post-auth flows bounce the user's browser (email
# confirmation landing, login redirect, the root "/" redirect). Must be
# browser-resolvable. Defaults to localhost; set to your LAN IP / tunnel /
# domain (with :5173 in dev) when the browser isn't on the same host.
FRONTEND_BASE_URL=http://localhost:5173

# CORS / CSRF — comma-separated origins the frontend is served from
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email. The console backend (default) prints emails to the docker logs
# instead of sending them — fine for dev, but with it new users never receive
# their verification link and invitees never get their invite. The dashboard
# shows an admin warning on the Invites page while delivery is unconfigured.
#
# For a real instance, switch to SMTP and fill in the EMAIL_* block below.
# Lettermint (https://lettermint.co) has a free tier and hands you ready-made
# SMTP credentials — paste them straight in.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@syncssh.dev
#
# Uncomment + fill to enable real delivery. Values below are Lettermint's SMTP
# settings — the username is the literal "lettermint" and the password is your
# project API token (https://lettermint.co/docs/guides/send-email-with-smtp).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.lettermint.co
# EMAIL_PORT=587
# EMAIL_HOST_USER=lettermint
# EMAIL_HOST_PASSWORD=<your-lettermint-project-token>
# EMAIL_USE_TLS=True

# Frontend — where Vite proxies API calls to (container name in docker)
VITE_API_PROXY=http://backend:8000

# Exposed to frontend — base URL the dashboard renders into the curl install
# command shown in the UI. The command is run *on the target server*, not in
# a browser, so it must be resolvable from there. The default targets the
# bundled testvps sandbox via docker DNS, so the quickstart works unmodified.
# For real external servers, set this to your tunnel/public URL (usually the
# same value as APP_BASE_URL).
VITE_INSTALL_BASE_URL=http://backend:8000

# Test VPS — root password for the SSH sandbox container (port 2222).
# DEV ONLY — this is for the local docker-compose `testvps` service. Never
# copy this value into a real .env that touches a production host.
VPS_ROOT_PASSWORD=syncssh
